# 长桥 OpenAPI 凭证
# 申请指引: https://open.longportapp.com/docs
LONGPORT_APP_KEY=your_app_key
LONGPORT_APP_SECRET=your_app_secret
LONGPORT_ACCESS_TOKEN=your_access_token

# 生产部署。公网 Basic Auth 配置在 VPS 共享 Caddy；
# 哈希使用 `caddy hash-password` 生成。
DOMAIN=trading.narutoooo.com
BASIC_AUTH_USER=trader
BASIC_AUTH_HASH='replace_with_caddy_bcrypt_hash'

# 站内登录（生产必须配置；本地默认关闭）
REQUIRE_AUTH=false
AUTH_USERNAME=trader
AUTH_PASSWORD=replace_with_a_strong_password
AUTH_REGISTRATION_CODE=replace_with_a_private_invitation_code
AUTH_SESSION_SECRET=replace_with_at_least_64_random_characters
AUTH_SESSION_HOURS=168
AUTH_COOKIE_SECURE=true

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key
AI_MODEL=claude-sonnet-4-20250514

# —— 每小时仓位体检 worker ——
HOURLY_ANALYSIS_ENABLED=true
HOURLY_ANALYSIS_NEWS_PER_STOCK=3
HOURLY_ANALYSIS_MODEL=
HOURLY_ANALYSIS_WEBSEARCH_ENABLED=true
HOURLY_ANALYSIS_RESEARCH_RESULTS=4
